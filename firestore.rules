rules_version = '2';

// Gesto Operação — regras do Firestore
// Projeto: gesto-estoque
//
// v111 (28/07/2026) — fechamento das brechas encontradas na revisão:
//   1. perfis: o usuário podia escrever o PRÓPRIO documento inteiro, inclusive `role`.
//      Um contador se promovia a admin pelo console do navegador.
//   2. historico: `allow write` para qualquer autenticado incluía DELETE — dava para
//      apagar o fechamento que alimenta o CSV do Saipos.
//   3. cfg_rotinas ficou de fora da whitelist de documentos de configuração protegidos.
//   4. `disabled` (conta desativada) só era checado no cliente.
//
// Publicação: Firebase Console → Firestore Database → Regras → colar → Publicar.
// Este arquivo é a fonte da verdade; qualquer alteração no console deve voltar para cá.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────
    function perfil(uid) {
      return get(/databases/$(database)/documents/perfis/$(uid)).data;
    }
    function perfilExiste(uid) {
      return exists(/databases/$(database)/documents/perfis/$(uid));
    }
    // Usuário válido: autenticado, com perfil e não desativado.
    function ativo() {
      return request.auth != null
        && perfilExiste(request.auth.uid)
        && perfil(request.auth.uid).get('disabled', false) == false;
    }
    // ATENÇÃO: os tipos de perfil do app são dinâmicos (Gestão › Usuários grava em
    // cfg_diario.rolesLista), mas as regras não leem essa configuração. Se você criar
    // OUTRO tipo marcado como "Gestor" no app, adicione o id dele na lista abaixo e
    // republique — senão esse usuário terá a interface de gestor mas o servidor vai
    // recusar as escritas dele.
    //
    // v119 — DOIS NÍVEIS. `isAdmin()` = gestor: opera tudo (cfg_*, fila do Diário).
    // `isAdminPleno()` = só o tipo 'admin': mexe em perfis e lê o log de acessos.
    // O app espelha essa divisão escondendo Usuários, Acessos, Sistema e as
    // Ferramentas avançadas de quem não é administrador pleno.
    function rolesGestores() {
      // 12/08/2026 — 'rlms3m6k068y2' = "Gestor" (Jedison). O papel existia desde
      // antes de 28/07 mas a lista de tipos de perfil (cfg_diario.rolesLista) se
      // perdeu, então ele apontava para um tipo inexistente e caía em
      // Contador/Conferente por fallback. A lista foi recriada com esse mesmo id
      // marcado como Gestor — sem o id aqui, ele teria a interface de gestor e o
      // servidor recusaria as escritas dele (cfg_*, fila do Diário, acessos).
      return ['admin', 'rlms3m6k068y2'];
    }
    function isAdmin() {
      return ativo() && perfil(request.auth.uid).role in rolesGestores();
    }
    // Administrador pleno: o tipo de id 'admin' (pode ser renomeado no app, o id não).
    function isAdminPleno() {
      return ativo() && perfil(request.auth.uid).role == 'admin';
    }
    // Campos que o próprio usuário nunca pode alterar em si mesmo.
    function naoMexeEmCampoProtegido() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'tabs', 'setor', 'setores', 'disabled', 'login']);
    }

    // ── perfis ─────────────────────────────────────────────────────────────
    // Leitura: o próprio documento sempre (senão o login não consegue nem descobrir
    // que o perfil não existe); os demais, só usuário ativo.
    // Criação: só admin. O primeiro admin é criado à mão no console do Firebase —
    // o app não cria mais perfil sozinho no primeiro acesso (era auto-promoção a admin).
    // Atualização: o próprio usuário mexe em nome/avatar/mustChangePassword,
    // mas nunca em role, setor, tabs, login ou disabled. Admin pode tudo.
    match /perfis/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || ativo());
      allow create: if isAdminPleno();
      allow update: if isAdminPleno()
        || (ativo() && request.auth.uid == uid && naoMexeEmCampoProtegido());
      allow delete: if isAdminPleno();
    }

    // ── usuarios (dados privados de cada um) ────────────────────────────────
    match /usuarios/{userId} {
      allow read, write: if ativo() && request.auth.uid == userId;
    }
    match /usuarios/{userId}/{sub=**} {
      allow read, write: if ativo() && request.auth.uid == userId;
    }

    // ── contagem_ativa (rascunhos + documentos de configuração) ─────────────
    // Os cfg_* são configuração global da loja e só admin escreve.
    // cfg_rotinas entrou na lista em v111.
    // cfg_alertas entrou em v113 (alerta de fator de conversão): a Cloud Function
    // escreve por admin SDK e ignora estas regras, mas o campo `resolvidos` é
    // marcado pelo app — e só gestor pode dar um alerta por resolvido.
    // cfg_reservas entrou em 09/08/2026 (módulo Reservas): horários bloqueados,
    // capacidade do 2º giro e tolerância de no-show. ATENÇÃO — esta lista é
    // LITERAL, não um prefixo `cfg_`: documento novo que não entre aqui fica
    // gravável por qualquer usuário ativo.
    match /contagem_ativa/{docId} {
      allow read: if ativo();
      allow write: if ativo() && (
        !(docId in ['cfg_config','cfg_specs','cfg_catalogo','cfg_fechamento',
                    'cfg_cardapio','cfg_diario','cfg_rotinas','cfg_alertas',
                    'cfg_reservas'])
        || isAdmin()
      );
    }

    // ── historico (contagens fechadas) ─────────────────────────────────────
    // Append-only: grava-se uma vez, nunca se edita nem se apaga pelo app.
    // Correção de fechamento é feita por admin direto no console, com rastro.
    match /historico/{id} {
      allow read: if ativo();
      allow create: if ativo();
      allow update, delete: if false;
    }

    // ── diario (produção, conferência, erros, desperdícios) ─────────────────
    match /diario/{id} {
      allow read: if ativo();
      allow create: if ativo() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();   // só admin muda status (lançado/ignorado)
      allow delete: if false;
    }

    // ── acessos (log de login) ─────────────────────────────────────────────
    // Falhas de login são gravadas pela Cloud Function (Admin SDK, ignora regras).
    // Aqui o próprio usuário só registra o próprio sucesso. Ninguém edita nem apaga.
    match /acessos/{id} {
      allow read: if isAdminPleno();
      allow create: if request.auth != null
        && request.resource.data.success == true
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── gestao (dados de gestão, escritos só por Cloud Function) ───────────
    // v140: estoque e custo médio do Saipos saíram do catálogo. O catálogo é a
    // base da contagem e precisa ser legível por qualquer usuário ativo; estoque
    // e custo são informação de gestão. Aqui a leitura exige gestor e a escrita é
    // negada a todos — quem grava é o Admin SDK das funções, que ignora regras.
    match /gestao/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Reservas (módulo Reservas GESTO, 09/08/2026) ───────────────────────
    // Escrita SEMPRE negada aqui: só as Cloud Functions do codebase `reservas`
    // escrevem, via Admin SDK, que ignora estas regras. O site público não usa
    // o SDK do Firestore — fala só com as functions. Logo nenhuma regra precisa
    // aceitar escrita anônima.
    // Leitura liberada para o painel (reservas.html) acompanhar a agenda ao
    // vivo com onSnapshot — a hostess não pode ficar recarregando a página.
    //
    // Papéis: `admin` faz tudo; `hostess` opera a agenda mas não configura.
    // `hostess` NÃO deve ser marcado como Gestor no app — é ficar de fora de
    // rolesGestores() que a impede de escrever nos cfg_*.
    function podeReservas() {
      return ativo() && perfil(request.auth.uid).role in ['admin', 'hostess'];
    }

    match /reservas/{id} {
      allow read: if podeReservas();
      allow write: if false;
    }

    // Base de clientes do salão: é o CRM da casa (o do Saipos não é acessível
    // por API — ver ACHADOS-API-CLIENTES.md). Mais sensível que a agenda, então
    // fica no gate de reservas e não no `ativo()` geral: contador e cozinha não
    // têm por que ler a base inteira de clientes.
    match /clientes/{id} {
      allow read: if podeReservas();
      allow write: if false;
    }

    // Controle de abuso dos endpoints públicos. Ninguém lê pelo app.
    // Configurar TTL no campo `expiraEm` (console do Firestore), senão cresce
    // para sempre.
    match /ratelimit/{id} {
      allow read, write: if false;
    }

    // ── negar o resto por padrão ───────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
